# Frontend (local: proxy /api; Railway/produção: /api no mesmo domínio)
VITE_API_URL=/api

# Server — copie para server/.env (local) ou Variables na Railway (produção)
DATABASE_URL=postgresql://avalia:avalia123@localhost:5433/avalia_imob
JWT_SECRET=avalia-imob-dev-secret-change-in-production
JWT_EXPIRES_IN=1d
PORT=3001
CORS_ORIGIN=http://localhost:5173

# IA — obrigatório para avaliação de imóveis
OPENAI_API_KEY=sk-sua-chave-openai
OPENAI_MODEL=gpt-4o

# Serper — pesquisa de imobiliárias e plano diretor
SERPER_API_KEY=sua-chave-serper

# Admin inicial (criado na migration se não existir)
# Use credenciais fortes e únicas em produção
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@avalia.com
ADMIN_PASSWORD=altere-esta-senha-forte

# Efí Bank — pagamentos (checkout transparente + PIX)
# Credenciais da aplicação (API Cobranças / API Pix) — https://dev.efipay.com.br/
EFI_CLIENT_ID=Client_Id_SuaAplicacao
EFI_CLIENT_SECRET=Client_Secret_SuaAplicacao
# true = homologação | false = produção
EFI_SANDBOX=true
# Identificador de conta (payee_code) — API > Introdução > Identificador de conta
# Usado no frontend para gerar o payment_token do cartão
EFI_PAYEE_CODE=seu_identificador_de_conta
# Certificado .p12 da API Pix (caminho do arquivo OU conteúdo base64)
EFI_CERTIFICATE=./certs/efi-pix.p12
# Se EFI_CERTIFICATE for base64, defina true
EFI_CERTIFICATE_BASE64=false
# Chave Pix cadastrada na conta Efí (obrigatória para créditos via PIX)
EFI_PIX_KEY=sua-chave-pix
# Opcional: ID do plano de assinatura já criado na Efí (senão é criado automaticamente)
# EFI_PLAN_ID=123456
# URL pública que recebe notificações da API Cobranças
# Em produção: https://seudominio.com/api/payments/webhooks/efi
EFI_NOTIFICATION_URL=http://localhost:3001/api/payments/webhooks/efi
# mTLS no webhook Pix (padrão false; a Efí também aceita sem mTLS em alguns cenários)
EFI_VALIDATE_MTLS=false
# URL do frontend para links de e-mail
APP_URL=http://localhost:5173

# SMTP Hostinger — e-mail de verificação de cadastro
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contato@seudominio.com
SMTP_PASS=sua-senha-do-email
SMTP_FROM=contato@seudominio.com
SMTP_FROM_NAME=Avalia Imob

# SSL do Postgres em produção (Railway etc.)
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Modo experimental: feedback pós-avaliação para a IA aprender (true/false)
EVALUATION_FEEDBACK_MODE=true

# WhatsApp — webhook de leads/avaliações
# Verificação Meta (GET /api/webhooks/whatsapp)
WHATSAPP_VERIFY_TOKEN=seu-token-de-verificacao-meta
# Secret para POST /api/webhooks/whatsapp/leads (header X-Webhook-Secret)
WHATSAPP_WEBHOOK_SECRET=seu-secret-webhook-longo-e-aleatorio
# App Secret Meta — valida X-Hub-Signature-256 no POST /api/webhooks/whatsapp
WHATSAPP_APP_SECRET=
