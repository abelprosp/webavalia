# Frontend (local: proxy /api; Railway/produção: /api no mesmo domínio)
VITE_API_URL=/api

# Server — copie para server/.env (local) ou Variables na Railway (produção)
DATABASE_URL=postgresql://avalia:avalia123@localhost:5433/avalia_imob
JWT_SECRET=avalia-imob-dev-secret-change-in-production
JWT_EXPIRES_IN=7d
PORT=3001
CORS_ORIGIN=http://localhost:5173

# IA — obrigatório para avaliação de imóveis
OPENAI_API_KEY=sk-sua-chave-openai
OPENAI_MODEL=gpt-4o

# Serper — pesquisa de imobiliárias e plano diretor
SERPER_API_KEY=sua-chave-serper

# Admin inicial (criado na migration se não existir)
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@avalia.com
ADMIN_PASSWORD=Admin123!@#

# AbacatePay — pagamentos PIX e checkout
ABACATEPAY_API_KEY=sua-chave-abacatepay
ABACATEPAY_WEBHOOK_SECRET=seu-secret-webhook
# Opcional: ID do produto do plano (criado automaticamente na primeira compra)
# ABACATEPAY_PLAN_PRODUCT_ID=prod_xxx
# URL do frontend para redirects pós-pagamento
APP_URL=http://localhost:5173
